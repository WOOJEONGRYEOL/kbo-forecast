# 파이썬
.venv/
__pycache__/
*.pyc

# 데이터 폴더는 캐시·CSV로 지저분하므로 통째로 무시하되,
# GitHub Pages가 서빙할 '생성된 대시보드 HTML' 2개만 예외로 추적합니다.
# (로고는 HTML에 base64로 내장돼 있어 logos/ 폴더는 서빙에 불필요)
data/*
!data/dashboard.html
!data/players.html
!data/today.html
!data/last_updated.json
!data/predictions.json
!data/predictions.html
!data/title_race.json
!data/title_race.html
# Statiz 파생 스냅샷(불펜·타자 WAR). CI(GitHub Actions)엔 Statiz 원본이 없어
# 재생성 불가하므로 캐시가 아니라 '필수 입력'으로 커밋한다.
!data/bullpen_*.csv
!data/statiz_*.csv
!data/history_*.csv
!data/history.html
!data/team_style_*.csv
!data/team_phase_*.csv
data/linescore/

# Statiz 크롤러(로컬 실행): 원본 출력·캐시·전용 venv는 커밋 안 함(요약 CSV만 커밋)
statiz_crawler/output/
statiz_crawler/__pycache__/
.venv_statiz/
